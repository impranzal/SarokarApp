PORT=5000
NODE_ENV=development

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/sarokar

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS - comma separated origins allowed to call this API
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Optional: only used if you wire in an LLM for richer summarization.
# Leave blank to fall back to the built-in lexicon/keyword pipeline.
ENABLE_LLM_SUMMARY=false
LLM_API_KEY=
